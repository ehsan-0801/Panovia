# ── Server ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database (Neon PostgreSQL) ──────────────────────────────────────
# Pooled connection for the API; the direct one is handy for migrations.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=verify-full"

# ── Auth ────────────────────────────────────────────────────────────
# Signs the access tokens this API issues. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs everyone out.
JWT_SECRET="<64-hex-characters>"
# Optional overrides
# JWT_TTL_SECONDS=604800
# PASSWORD_RESET_TTL_MINUTES=60

# ── Cloudinary (image uploads) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=panovia

# ── Resend (transactional email) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Panovia <onboarding@resend.dev>"
APP_URL=http://localhost:5173
